# ==============================================================================
# MRD Online Clinic — Backend environment (copy to .env and fill in values)
# ==============================================================================

# ------------------------------------------------------------------------------
# Runtime
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ------------------------------------------------------------------------------
# MongoDB
# ------------------------------------------------------------------------------
# Local:
# MONGODB_URI=mongodb://127.0.0.1:27017/mrdonlineclinic
# Atlas (replace user, password, cluster host; database name before ?):
MONGODB_URI=mongodb+srv://YOUR_DB_USER:<db_password>@cluster0.xxxxx.mongodb.net/mrdonlineclinic?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# JWT — each secret must be at least 32 characters
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-to-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-another-32-chars-minimum!!
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# ------------------------------------------------------------------------------
# Public app URL (email links: verify, reset). CORS allows any browser origin.
# ------------------------------------------------------------------------------
CLIENT_URL=http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Super Admin bootstrap (optional — runs only if no SUPER_ADMIN exists yet)
# ------------------------------------------------------------------------------
SEED_SUPERADMIN_EMAIL=admin@mrdclinic.com
SEED_SUPERADMIN_PASSWORD=Admin123!

# ------------------------------------------------------------------------------
# SMTP (optional — omit SMTP_HOST to log emails instead of sending)
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@example.com

# ------------------------------------------------------------------------------
# ImageKit — server uploads (see Dashboard → Developer → API keys)
# ------------------------------------------------------------------------------
# All three must be set for profile/credentials/prescription uploads to work.
# Use quotes around keys if they contain + or /
# IMAGEKIT_PUBLIC_KEY="public_xxx..."
# IMAGEKIT_PRIVATE_KEY="private_xxx..."
# IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<your_imagekit_id>
